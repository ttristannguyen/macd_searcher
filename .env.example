# Copy to .env and fill in real values. .env is gitignored.

# Telegram bot — create via @BotFather, then get chat_id by messaging the bot
# and calling https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Trading bot, live runs only (docs/trading_bot.md). Use an API agent wallet: it can
# trade but not withdraw. HYPERLIQUID_ACCOUNT is the address of the main account.
HYPERLIQUID_AGENT_KEY=
HYPERLIQUID_ACCOUNT=
# Optional: a separate Telegram chat for the trading messages.
TRADER_TELEGRAM_CHAT_ID=

# Optional overrides
# MACD_SEARCHER_CONFIG=config.yaml
# MACD_SEARCHER_LOG_LEVEL=INFO
